				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1794807601698</Id>
					<Name><![CDATA[tiempoTramo]]></Name>
					<X>2450</X><Y>1310</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ida]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[tramo]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[double[] p = (ida ? T_IDA : T_VUELTA)[tramo - 1][franjaTiempo(hora())];
double x = triangular(p[0], p[1], p[2]) * FACTOR_BUS;     // triangular(min, max, moda)
boolean via = (ida && tramo == 8) || (!ida && tramo == 1);
return via ? x * factorViaCampus : x;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
