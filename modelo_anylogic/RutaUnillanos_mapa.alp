			<AdditionalClassCode><![CDATA[static final int CAP_TOTAL = 51, CAP_SENTADOS = 41;
static final double FACTOR_BUS = 1.10, T_FIJO = 10 / 60.0, T_SUBIR = 3 / 60.0, T_BAJAR = 2 / 60.0;
// Probabilidad de que el pasajero de ida aborde en cada paradero (parque … eds_primax_ocoa)
static final double[] PESO_IDA = {0.30, 0.15, 0.10, 0.10, 0.10, 0.10, 0.10, 0.05};
// Destino de la vuelta: índice 1..7 = u_cooperativa, alborada, makro, colegio, tecniguayas, unicentro, parque
static final double[] PROB_DESTINO = {0.10, 0.10, 0.10, 0.10, 0.10, 0.15, 0.35};
// Animación sobre el mapa OSM (zona de 854 x 720 px). Solo presentación.
// Paraderos: parque, unicentro, tecniguayas, frente_colegio_industrial, makro, alborada,
// universidad_cooperativa, eds_primax_ocoa, barcelona (lat/lon -> píxeles, proyección lineal)
double[] PX = {202.9, 222.8, 253.6, 277.8, 325.0, 350.5, 433.8, 495.6, 658.4};
double[] PY = {37.2, 61.8, 103.0, 135.2, 197.5, 231.1, 308.6, 358.5, 681.3};
// Recorridos dibujados sobre la vía. Entre EDS Primax y Barcelona hay 3 puntos de paso (no son paraderos).
double[] X_IDA    = {202.9, 222.8, 253.6, 277.8, 325.0, 350.5, 433.8, 495.6, 735.1, 744.2, 706.0, 658.4};
double[] Y_IDA    = {37.2, 61.8, 103.0, 135.2, 197.5, 231.1, 308.6, 358.5, 542.1, 603.3, 635.9, 681.3};
int[] PAR_IDA = {0, 1, 2, 3, 4, 5, 6, 7, 11};        // posición de cada paradero de ida en X_IDA/Y_IDA
// Vuelta: la misma vía desplazada 6 px para que no se superpongan los buses
double[] X_VUELTA = {662.5, 710.0, 749.9, 740.3, 499.3, 437.7, 354.9, 329.8, 282.6, 258.4, 227.5, 207.6};
double[] Y_VUELTA = {685.6, 640.4, 605.4, 539.1, 353.8, 304.1, 227.1, 193.9, 131.6, 99.4, 58.1, 33.4};
int[] PAR_VUELTA = {0, 5, 6, 7, 8, 9, 10, 11};      // Barcelona, U. Cooperativa, ..., Parque

double[][][] T_IDA = {  // [tramo-1][franja 0=pico_am 1=valle 2=pico_pm][min, max, moda]
  {{1.5, 2.5, 2}, {3, 4, 3}, {2, 6, 4}},  // 1: parque -> unicentro
  {{1.5, 2.5, 2}, {1.5, 2.5, 2}, {2, 3, 3}},  // 2: unicentro -> tecniguayas
  {{0.5, 1.5, 1}, {1.5, 2.5, 2}, {1.5, 2.5, 2}},  // 3: tecniguayas -> frente_colegio_industrial
  {{1.5, 2.5, 2}, {1.5, 2.5, 2}, {2, 3, 3}},  // 4: frente_colegio_industrial -> makro
  {{1, 2, 1}, {1, 2, 1}, {1.5, 2.5, 2}},  // 5: makro -> alborada
  {{1.5, 2.5, 2}, {1.5, 2.5, 2}, {2, 3, 3}},  // 6: alborada -> universidad_cooperativa
  {{1.5, 2.5, 2}, {1.5, 2.5, 2}, {2, 3, 2}},  // 7: universidad_cooperativa -> eds_primax_ocoa
  {{7, 12, 7.75}, {7, 12, 9}, {8, 12, 10}}   // 8: eds_primax_ocoa -> barcelona
};
double[][][] T_VUELTA = {
  {{8, 14, 10.5}, {9, 16, 11.75}, {9, 16, 11.5}},  // 1: barcelona -> universidad_cooperativa
  {{1.5, 2.5, 2}, {2.5, 3.5, 3}, {2, 6, 2.5}},  // 2: universidad_cooperativa -> alborada
  {{1, 2, 1}, {1.5, 2.5, 2}, {1.5, 2.5, 2}},  // 3: alborada -> makro
  {{1.5, 2.5, 2}, {1.5, 2.5, 2}, {1.5, 2.5, 2}},  // 4: makro -> frente_colegio_industrial
  {{0.5, 1.5, 1}, {1.5, 2.5, 2}, {1.5, 2.5, 2}},  // 5: frente_colegio_industrial -> tecniguayas
  {{0.5, 1.5, 1}, {1.5, 2.5, 2}, {1.5, 2.5, 2}},  // 6: tecniguayas -> unicentro
  {{2.5, 3.5, 3}, {3, 7, 4.75}, {3, 8, 3.25}}   // 7: unicentro -> parque
};]]></AdditionalClassCode>
