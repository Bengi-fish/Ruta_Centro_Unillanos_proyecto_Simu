				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Color]]></ReturnType>
					<Id>1794806526357</Id>
					<Name><![CDATA[colorBus]]></Name>
					<X>340</X><Y>330</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double o = abordo.size() / 41.0;
return o < 0.7 ? new Color(27, 175, 122) : o < 1.0 ? new Color(237, 161, 0) : new Color(227, 73, 72);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[]]]></ReturnType>
					<Id>1794812000002</Id>
					<Name><![CDATA[posAnim]]></Name>
					<X>340</X><Y>380</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Posición del bus sobre el mapa: misma fracción de avance f que antes, ahora en x e y
double f;
double[] X = esIda ? main.X_IDA : main.X_VUELTA, Y = esIda ? main.Y_IDA : main.Y_VUELTA;
int[] P = esIda ? main.PAR_IDA : main.PAR_VUELTA;
if (statechart.isStateActive(EnTramo)) {
    f = Math.min(1, (time() - tIni) / Math.max(tTramo, 1e-6));
    return main.puntoRuta(X, Y, P[idx], P[idx + 1], f);
}
if (statechart.isStateActive(EnParada) || statechart.isStateActive(Alistando))
    return new double[]{X[P[idx]], Y[P[idx]]};
if (statechart.isStateActive(EnVacio)) {
    f = Math.min(1, (time() - tIni) / Math.max(tVacio, 1e-6));
    return haciaCampus ? main.puntoRuta(main.X_IDA, main.Y_IDA, 0, main.X_IDA.length - 1, f)
                       : main.puntoRuta(main.X_VUELTA, main.Y_VUELTA, 0, main.X_VUELTA.length - 1, f);
}
int k = Math.max(0, enCampus ? main.libresCampus.indexOf(this) : main.libresParque.indexOf(this));
return enCampus ? new double[]{main.PX[8] + 26 + 22 * k, main.PY[8]}    // estacionado en Barcelona
                : new double[]{main.PX[0] + 26 + 22 * k, main.PY[0] - 20};   // estacionado en el Parque]]></Body>
				</Function>
			</Functions>

