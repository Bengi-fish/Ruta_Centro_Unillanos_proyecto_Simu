					<X>2450</X><Y>1470</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double u = uniform(), acum = 0;
for (int k = 0; k < PROB_DESTINO.length; k++) { acum += PROB_DESTINO[k]; if (u < acum) return k + 1; }
return 7;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1794807771633</Id>
					<Name><![CDATA[tasaIda]]></Name>
					<X>2450</X><Y>1520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (t < 300 || t >= 1315) return 0;                 // ventana 5:00–21:55
if (t >= 1140) return 30 * factorDemanda;           // noche
double[] TASA = {140, 45, 30, 90};                  // pico_am, valle, pico_pm, pico_md
return TASA[franja(t)] * factorDemanda;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1794807789095</Id>
					<Name><![CDATA[tasaVuelta]]></Name>
					<X>2450</X><Y>1580</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (t < 460 || t >= 1315) return 0;                 // ventana 7:40–21:55
if (t >= 1140) return 30 * factorDemanda;           // noche
double[] TASA = {0, 45, 150, 130};
return TASA[franja(t)] * factorDemanda;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1794807841965</Id>
					<Name><![CDATA[actualizarTasas]]></Name>
					<X>2450</X><Y>1630</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (time() % 2880 >= 1440) {             // segundo día del bloque: solo terminan los viajes atrasados
    srcIda.set_rate(0, PER_HOUR); srcVuelta.set_rate(0, PER_HOUR); return;
}
srcIda.set_rate(tasaIda(hora()), PER_HOUR);
srcVuelta.set_rate(tasaVuelta(hora()), PER_HOUR);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1794807862015</Id>
					<Name><![CDATA[atenderParada]]></Name>
					<X>2740</X><Y>1150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[b]]></Name>
						<Type><![CDATA[Bus]]></Type>
					</Parameter>
					<Body><![CDATA[double t = time();
if (b.esIda) {
    if (b.idx < 8) {                                   // paraderos de ida: solo suben
        int cupo = CAP_TOTAL - b.abordo.size();
        ArrayList<Pasajero> suben = new ArrayList<Pasajero>();
        for (int i = 0; i < waitIda.size() && suben.size() < cupo; i++) {
            Pasajero p = waitIda.get(i);
            if (p.origen == b.idx) suben.add(p);
        }
        if (suben.isEmpty()) return 0;
        double d = T_FIJO + T_SUBIR * suben.size();
        for (Pasajero p : suben) { p.tSube = t + d; b.abordo.add(p); waitIda.free(p); }
        return d;
    }
    double d = T_FIJO + T_BAJAR * b.abordo.size();     // Barcelona: bajan todos
    for (Pasajero p : b.abordo) registrarViaje(p, t + d);
    b.abordo.clear();
    return d;
}
if (b.idx == 0) {                                      // Barcelona: suben en orden de llegada
    int n = Math.min(CAP_TOTAL, waitCampus.size());
    if (n == 0) return 0;
    double d = T_FIJO + T_SUBIR * n;
    ArrayList<Pasajero> suben = new ArrayList<Pasajero>();
    for (int i = 0; i < n; i++) suben.add(waitCampus.get(i));
    for (Pasajero p : suben) { p.tSube = t + d; b.abordo.add(p); waitCampus.free(p); }
    return d;
}
ArrayList<Pasajero> bajan = new ArrayList<Pasajero>();  // paraderos de vuelta: solo bajan
for (Pasajero p : b.abordo) if (p.destino == b.idx) bajan.add(p);
if (bajan.isEmpty()) return 0;
double d = T_FIJO + T_BAJAR * bajan.size();
for (Pasajero p : bajan) { registrarViaje(p, t + d); b.abordo.remove(p); }
return d;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1794807906762</Id>
					<Name><![CDATA[registrarViaje]]></Name>
					<X>2740</X><Y>1210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[Pasajero]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[tBaja]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[double espera = p.tSube - p.tLlega;
stEspera.add(espera);
histEspera.add(espera);
if (p.esIda) stEsperaIda.add(espera); else stEsperaVuelta.add(espera);
stPuerta.add(tBaja - p.tLlega);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1794807958575</Id>
					<Name><![CDATA[registrarOcupacion]]></Name>
					<X>2740</X><Y>1260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[b]]></Name>
						<Type><![CDATA[Bus]]></Type>
					</Parameter>
					<Body><![CDATA[double o = b.abordo.size() / (double) CAP_SENTADOS;
stOcup.add(o);
tramosDia++;
if (o > 1) sobreSentados++;
int s = b.esIda ? 0 : 1;
ocupSum[s][b.idx] += o;
ocupN[s][b.idx]++;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1794807995729</Id>
					<Name><![CDATA[despachar]]></Name>
					<X>2740</X><Y>1310</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ida]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[LinkedList<Double> pend = ida ? pendIda : pendVuelta;
LinkedList<Bus> libres = ida ? libresParque : libresCampus;
while (!pend.isEmpty() && !libres.isEmpty()) {
    double programada = pend.removeFirst();
    if (ida) restIda--; else restVuelta--;
    Bus b = libres.removeFirst();
    stRetraso.add(time() - programada);
    b.iniciarViaje(ida);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1794808032426</Id>
					<Name><![CDATA[quedarLibre]]></Name>
					<X>2740</X><Y>1360</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[b]]></Name>
						<Type><![CDATA[Bus]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[campus]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[b.enCampus = campus;
if (campus) libresCampus.add(b); else libresParque.add(b);
despachar(!campus);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1794808083298</Id>
					<Name><![CDATA[debeTrasladarse]]></Name>
					<X>2740</X><Y>1420</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[b]]></Name>
						<Type><![CDATA[Bus]]></Type>
					</Parameter>
					<Body><![CDATA[b.enCampus = b.esIda;                    // terminó la ida: está en el campus; terminó la vuelta: está en el Parque
return false;                            // sin traslados vacíos: cada bus alterna ida y vuelta]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1794808128431</Id>
					<Name><![CDATA[cerrarDia]]></Name>
					<X>2740</X><Y>1470</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int sinServicio = waitIda.size() + waitCampus.size();
waitIda.freeAll();
waitCampus.freeAll();
if (stEspera.count() > 0) {
    dEspera.add(stEspera.mean());   dPuerta.add(stPuerta.mean());   dOcup.add(stOcup.mean());
    dEsperaIda.add(stEsperaIda.mean());   dEsperaVuelta.add(stEsperaVuelta.mean());
    dRetraso.add(stRetraso.mean()); dCanceladas.add(canceladas); dSinServicio.add(sinServicio);
    dSobreSentados.add(sobreSentados / (double) Math.max(tramosDia, 1));
    traceln(String.format("dia;%d;%.3f;%.3f;%.3f;%.3f;%.3f;%.3f;%.3f;%d",
        (int) (time() / 2880), stEspera.mean(), stEsperaIda.mean(), stEsperaVuelta.mean(),
        stPuerta.mean(), stOcup.mean(), stRetraso.mean(), stRetraso.max(), sinServicio));
}
stEspera.reset(); stEsperaIda.reset(); stEsperaVuelta.reset(); stPuerta.reset();
stOcup.reset(); stRetraso.reset();
canceladas = 0; sobreSentados = 0; tramosDia = 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1794808149247</Id>
					<Name><![CDATA[contarEnParada]]></Name>
					<X>2740</X><Y>1520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[k]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[int c = 0;
for (int i = 0; i < waitIda.size(); i++) if (waitIda.get(i).origen == k) c++;
return c;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[]]]></ReturnType>
					<Id>1794812000001</Id>
					<Name><![CDATA[puntoRuta]]></Name>
					<X>2740</X><Y>1560</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[X]]></Name>
						<Type><![CDATA[double[]]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[Y]]></Name>
						<Type><![CDATA[double[]]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[a]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[b]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[f]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[// Punto a la fracción f (0..1) del recorrido entre los puntos a y b (interpolación lineal por tramos)
double total = 0;
for (int i = a; i < b; i++) total += Math.hypot(X[i + 1] - X[i], Y[i + 1] - Y[i]);
double d = Math.max(0, Math.min(1, f)) * total;
for (int i = a; i < b; i++) {
    double s = Math.hypot(X[i + 1] - X[i], Y[i + 1] - Y[i]);
    if (d <= s || i == b - 1) {
        double g = s > 0 ? Math.min(1, d / s) : 0;
        return new double[]{X[i] + g * (X[i + 1] - X[i]), Y[i] + g * (Y[i + 1] - Y[i])};
    }
    d -= s;
}
return new double[]{X[b], Y[b]};]]></Body>
				</Function>
			</Functions>
