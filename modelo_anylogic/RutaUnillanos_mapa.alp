					<Name><![CDATA[inicioDia]]></Name>
					<X>2740</X><Y>1590</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_MINUTE]]></Unit>
						</Rate>
						<Id>1794808192179</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1794816000000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[2880]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if (time() > 0) cerrarDia();
if (time() >= nDias * 2880) { finishSimulation(); return; }
libresParque.clear(); libresCampus.clear(); pendIda.clear(); pendVuelta.clear();
int k = 0;
for (Bus b : buses) {                     // los buses amanecen repartidos entre los dos extremos
    b.enCampus = k >= (flota + 1) / 2;
    if (b.enCampus) libresCampus.add(b); else libresParque.add(b);
    k++;
}
restIda = 51; restVuelta = 51;
for (int j = 0; j < 51; j++) {            // 5:20 … 22:00, cada 20 min, en ambos sentidos
    create_Salida(320 + 20 * j, true);
    create_Salida(320 + 20 * j, false);
}]]></Action>
					<Logging>false</Logging>
				</Event>
